<div class="lv-field @Class">
    <label class="lv-label" for="@_id">
        @Label
        @if (Required)
        {
            <span class="lv-required" aria-hidden="true">*</span>
        }
    </label>
    @if (Multiline)
    {
        <textarea id="@_id"
                  class="lv-textarea"
                  rows="@Rows"
                  placeholder="@Placeholder"
                  disabled="@Disabled"
                  required="@Required"
                  aria-invalid="@(!string.IsNullOrWhiteSpace(ErrorText) ? "true" : null)"
                  aria-describedby="@(!string.IsNullOrWhiteSpace(ErrorText) ? _errorId : null)"
                  value="@Value"
                  @oninput="HandleInput"></textarea>
    }
    else
    {
        <input id="@_id"
               class="lv-input"
               type="@InputType"
               placeholder="@Placeholder"
               disabled="@Disabled"
               required="@Required"
               aria-invalid="@(!string.IsNullOrWhiteSpace(ErrorText) ? "true" : null)"
               aria-describedby="@(!string.IsNullOrWhiteSpace(ErrorText) ? _errorId : null)"
               value="@Value"
               @oninput="HandleInput" />
    }
    @if (!string.IsNullOrWhiteSpace(ErrorText))
    {
        <span id="@_errorId" class="lv-field-error" role="alert">@ErrorText</span>
    }
</div>

@code {
    private readonly string _id = $"lv-f-{Guid.NewGuid():N}";
    private readonly string _errorId = $"lv-error-{Guid.NewGuid():N}";

    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string InputType { get; set; } = "text";
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Multiline { get; set; }
    [Parameter] public int Rows { get; set; } = 3;
    [Parameter] public string? ErrorText { get; set; }
    [Parameter] public string? Class { get; set; }

    private Task HandleInput(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString());
}
