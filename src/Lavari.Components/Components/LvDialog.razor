@implements IAsyncDisposable
@inject Microsoft.JSInterop.IJSRuntime JS
@using Microsoft.JSInterop

@if (Open)
{
        <dialog @ref="_dialog" class="lv-dialog" aria-labelledby="@_titleId" @onkeydown="HandleKeyDown">
            <div class="lv-card-header" style="margin-bottom:0">
                <h2 id="@_titleId" class="lv-card-title">@Title</h2>
                @if (Dismissible)
                {
                    <LvButton Variant="outlined" Small="true" OnClick="OnClose">Close</LvButton>
                }
            </div>
            <div>@ChildContent</div>
            @if (Actions is not null)
            {
                <div class="lv-dialog-actions">@Actions</div>
            }
        </dialog>
}

@code {
    private readonly string _titleId = $"lv-dlg-{Guid.NewGuid():N}";
    private ElementReference _dialog;
    private bool _shown;

    [Parameter] public bool Open { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public bool Dismissible { get; set; } = true;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (_shown && !Open)
        {
            try { await JS.InvokeVoidAsync("lavariInterop.closeDialog", _dialog); }
            catch (JSDisconnectedException) { }
            _shown = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Open && !_shown)
        {
            try
            {
                await JS.InvokeVoidAsync("lavariInterop.openDialog", _dialog);
                _shown = true;
            }
            catch (JSDisconnectedException) { }
        }
    }

    private Task HandleKeyDown(KeyboardEventArgs args) =>
        Dismissible && args.Key == "Escape" ? OnClose.InvokeAsync() : Task.CompletedTask;

    public async ValueTask DisposeAsync()
    {
        if (!_shown) return;
        try { await JS.InvokeVoidAsync("lavariInterop.closeDialog", _dialog); }
        catch (JSDisconnectedException) { }
    }
}
