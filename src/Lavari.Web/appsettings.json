{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Lavari": {
    "DatabasePath": "",
    "StorageRoot": "",
    "Cache": {
      "SizeLimit": 10000,
      "DefaultAbsoluteExpirationMinutes": 15,
      "DefaultSlidingExpirationMinutes": 5
    },
    "Integrations": {
      "Gmail": {
        "Enabled": false
      },
      "Gemini": {
        "Enabled": false,
        "Model": "gemini-3.5-flash-lite"
      }
    },
    "AiBudget": {
      "Currency": "AUD",
      "DailyLimitCents": 15000,
      "UserDailyLimitCents": 15000,
      "UserDailyRequests": 150,
      "ReservationCents": 100
    }
  }
}
