@page "/images"
@inject LavariBrowserApiClient Api
@inject AppSessionState AppState

<div class="lv-row" style="justify-content:space-between">
    <h1 class="lv-page-title">Image Library</h1>
    <div class="lv-row">
        <input class="lv-input" style="width:200px" aria-label="Search images" placeholder="Search images..." @bind="_search" />
        <select class="lv-select" style="width:180px" aria-label="Filter by client" @bind="_filterClientId">
            <option value="">All Clients</option>
            @foreach (var c in _clients) { <option value="@c.Id">@c.Name</option> }
        </select>
        <select class="lv-select" style="width:180px" aria-label="Filter by job" @bind="_filterJobId">
            <option value="">All Jobs</option>
            @foreach (var j in _jobs) { <option value="@j.Id">@j.Name</option> }
        </select>
        <LvButton Variant="tonal" OnClick="LoadAsync" Loading="_loading">Filter</LvButton>
        @if (AppState.Can(ModuleKeys.ImageLibrary, AccessLevel.Alter))
        {
            <LvButton OnClick="() => _showUploadModal = true">Upload Image</LvButton>
        }
    </div>
</div>

<LvErrorBanner Error="_error" />
@if (!string.IsNullOrWhiteSpace(_uploadNotice))
{
    <div class="lv-banner-success">@_uploadNotice</div>
}

<div class="lv-grid-4">
    @foreach (var img in _images)
    {
        <LvCard Title="@img.Title">
            <img src="/api/images/@img.Id/content?thumb=true" alt="@img.Title"
                 style="width:100%;height:170px;object-fit:cover;border-radius:8px;margin-bottom:10px;background:var(--md-sys-color-surface-container)" />
            <div class="lv-row" style="margin-bottom:8px">
                @if (img.IsGlobalLibrary) { <LvBadge Tone="primary">Global</LvBadge> }
                @foreach (var a in img.Associations)
                {
                    if (!string.IsNullOrWhiteSpace(a.JobName)) { <LvBadge>@a.JobName</LvBadge> }
                    else if (!string.IsNullOrWhiteSpace(a.ClientName)) { <LvBadge>@a.ClientName</LvBadge> }
                }
            </div>
            <div class="lv-row">
                <a class="lv-btn lv-btn-tonal lv-btn-sm" href="/api/images/@img.Id/content" target="_blank" rel="noopener">View image</a>
                @if (AppState.Can(ModuleKeys.ImageLibrary, AccessLevel.Delete))
                {
                    <LvButton Variant="outlined" Small="true" OnClick="() => DeleteImageAsync(img)">Delete</LvButton>
                }
            </div>
            <details><summary>Image details</summary><small>@img.Width × @img.Height · @img.ContentType</small></details>
        </LvCard>
    }
</div>

@if (!_loading && _error is null && _images.Count == 0)
{
    <p>No images found. Try changing the filters or upload an image.</p>
}

<LvDialog Open="_showUploadModal" Title="Upload Image to Library" OnClose="() => _showUploadModal = false">
    <ChildContent>
        <div style="display:flex;flex-direction:column;gap:12px">
            <div class="lv-banner-warning" style="font-size:0.84rem">
                Images larger than 1080p are automatically resized preserving aspect ratio (max 1920×1080 landscape, 1080×1920 portrait, 1080×1080 square). Larger originals are not retained.
            </div>
            <LvTextField Label="Title" Required="true" Value="@_upTitle" ValueChanged="v => _upTitle = v ?? string.Empty" />
            <LvTextField Label="Description" Value="@_upDesc" ValueChanged="v => _upDesc = v" />
            <div class="lv-grid-2">
                <div class="lv-field">
                    <label class="lv-label">Associate Client (optional)</label>
                    <select class="lv-select" @bind="_upClientId">
                        <option value="">None</option>
                        @foreach (var c in _clients) { <option value="@c.Id">@c.Name</option> }
                    </select>
                </div>
                <div class="lv-field">
                    <label class="lv-label">Associate Job (optional)</label>
                    <select class="lv-select" @bind="_upJobId">
                        <option value="">None</option>
                        @foreach (var j in _jobs) { <option value="@j.Id">@j.Name</option> }
                    </select>
                </div>
            </div>
            <div class="lv-field">
                <label class="lv-label">Image File (JPEG, PNG or WebP) <span class="lv-required">*</span></label>
                <InputFile OnChange="OnFileSelected" accept="image/jpeg,image/png,image/webp" />
            </div>
            <label class="lv-row" style="font-size:0.85rem">
                <input type="checkbox" @bind="_upRights" /> I confirm rights to use this image.
            </label>
        </div>
    </ChildContent>
    <Actions>
        <LvButton Variant="outlined" OnClick="() => _showUploadModal = false">Cancel</LvButton>
        <LvButton Loading="_uploading" Disabled="@(_selectedFileBytes is null || string.IsNullOrWhiteSpace(_upTitle))" OnClick="UploadAsync">Upload &amp; Process</LvButton>
    </Actions>
</LvDialog>

@code {
    private List<ImageAssetDto> _images = [];
    private List<ClientDto> _clients = [];
    private List<JobDto> _jobs = [];
    private string _search = string.Empty;
    private string _filterClientId = string.Empty;
    private string _filterJobId = string.Empty;
    private bool _loading = true;
    private bool _uploading;
    private ApiErrorResponse? _error;
    private string? _uploadNotice;

    private bool _showUploadModal;
    private string _upTitle = string.Empty;
    private string? _upDesc;
    private string _upClientId = string.Empty;
    private string _upJobId = string.Empty;
    private bool _upRights = true;
    private byte[]? _selectedFileBytes;
    private string _selectedFileName = "image.jpg";
    private string _selectedContentType = "image/jpeg";

    protected override async Task OnInitializedAsync()
    {
        var cResp = await Api.GetAsync<PagedResult<ClientDto>>("/api/clients?page=1&pageSize=100");
        if (cResp.IsSuccess && cResp.Data is not null) _clients = cResp.Data.Items.ToList();
        var jResp = await Api.GetAsync<PagedResult<JobDto>>("/api/jobs?page=1&pageSize=100");
        if (jResp.IsSuccess && jResp.Data is not null) _jobs = jResp.Data.Items.ToList();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var url = $"/api/images?page=1&pageSize=48&search={Uri.EscapeDataString(_search)}";
            if (!string.IsNullOrWhiteSpace(_filterClientId)) url += $"&clientId={_filterClientId}";
            if (!string.IsNullOrWhiteSpace(_filterJobId)) url += $"&jobId={_filterJobId}";
            var resp = await Api.GetAsync<PagedResult<ImageAssetDto>>(url);
            if (!resp.IsSuccess) { _error = resp.Error; return; }
            _images = resp.Data?.Items.ToList() ?? [];
        }
        finally { _loading = false; }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        _selectedFileName = file.Name;
        _selectedContentType = file.ContentType;
        if (string.IsNullOrWhiteSpace(_upTitle)) _upTitle = Path.GetFileNameWithoutExtension(file.Name);
        using var ms = new MemoryStream();
        await file.OpenReadStream(25 * 1024 * 1024).CopyToAsync(ms);
        _selectedFileBytes = ms.ToArray();
    }

    private async Task UploadAsync()
    {
        if (_selectedFileBytes is null) return;
        _uploading = true;
        _error = null;
        _uploadNotice = null;
        try
        {
            var fields = new Dictionary<string, string?>
            {
                ["title"] = _upTitle,
                ["description"] = _upDesc,
                ["rightsConfirmed"] = _upRights.ToString(),
                ["isGlobalLibrary"] = "true",
                ["clientId"] = string.IsNullOrWhiteSpace(_upClientId) ? null : _upClientId,
                ["jobId"] = string.IsNullOrWhiteSpace(_upJobId) ? null : _upJobId
            };
            var resp = await Api.UploadFileAsync<ImageAssetDto>("/api/images/upload", fields, _selectedFileName, _selectedContentType, _selectedFileBytes);
            if (!resp.IsSuccess) { _error = resp.Error; return; }
            _uploadNotice = $"Saved '{resp.Data!.Title}' at {resp.Data.Width}×{resp.Data.Height}px" +
                            (resp.Data.WasDownscaledFromLargerOriginal ? " (resized to 1080p limit)." : ".");
            _showUploadModal = false;
            _selectedFileBytes = null;
            await LoadAsync();
        }
        finally { _uploading = false; }
    }

    private async Task DeleteImageAsync(ImageAssetDto img)
    {
        _error = null;
        var resp = await Api.DeleteAsync($"/api/images/{img.Id}?token={Uri.EscapeDataString(img.ConcurrencyToken)}");
        if (!resp.IsSuccess) { _error = resp.Error; return; }
        await LoadAsync();
    }
}
