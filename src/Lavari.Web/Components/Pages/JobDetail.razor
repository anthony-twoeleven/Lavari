    private TimeEntryDto? _timeEditTarget;
    private bool _stoppingTimer;
    private string? _timeEditDescription;
    private DateOnly _timeEditDate;
    private long? _timeEditSeconds;
    private bool _timeEditBillable;
    private ApiErrorResponse? _timeEditError;

    private bool CanSaveTimeEdit => _timeEditTarget is { } entry && _timeEditDescription?.Length is not > 2000 &&
        (_stoppingTimer || (_timeEditSeconds > 0 &&
            (_timeEditSeconds != entry.DurationSeconds || _timeEditDate != entry.WorkDate ||
             _timeEditBillable != entry.IsBillable || _timeEditDescription != entry.Description)));

    private void OpenTimeEdit(TimeEntryDto entry, bool stop)
    {
        _timeEditTarget = entry;
        _stoppingTimer = stop;
        _timeEditDescription = entry.Description;
        _timeEditDate = entry.WorkDate;
        _timeEditSeconds = entry.DurationSeconds;
        _timeEditBillable = entry.IsBillable;
        _timeEditError = null;
    }

    private void CloseTimeEdit()
    {
        if (!_saving) _timeEditTarget = null;
    }

    private async Task SaveTimeEditAsync()
    {
        if (!CanSaveTimeEdit || _saving || _timeEditTarget is not { } entry) return;
        _saving = true;
        _timeEditError = null;
        try
        {
            var url = $"/api/time/{entry.Id}";
            var result = _stoppingTimer
                ? await Api.PostAsync<TimeEntryDto>($"{url}/stop?token={Uri.EscapeDataString(entry.ConcurrencyToken)}",
                    new StopTimerRequest { Description = _timeEditDescription })
                : await Api.PutAsync<TimeEntryDto>(url, new UpdateTimeEntryRequest
                {
                    Description = _timeEditDescription,
                    WorkDate = _timeEditDate,
                    DurationSeconds = _timeEditSeconds,
                    IsBillable = _timeEditBillable,
                    ConcurrencyToken = entry.ConcurrencyToken
                });
            if (!result.IsSuccess) { _timeEditError = result.Error; return; }
            _timeEditTarget = null;
            await RefreshTabDataAsync();
        }
        finally { _saving = false; }
    }
