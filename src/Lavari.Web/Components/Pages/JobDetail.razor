@page "/jobs/{JobId:guid}"
@implements IAsyncDisposable
@inject LavariBrowserApiClient Api
@inject AppSessionState AppState
@inject IFormattingService Formatting
@inject Microsoft.JSInterop.IJSRuntime JS
@using Microsoft.JSInterop

@if (_job is null && _loading)
{
    <p><span class="lv-spinner"></span> Loading job workspace...</p>
}
else if (_job is null)
{
    <LvErrorBanner Error="_error" />
}
else
{
    <div class="lv-row" style="justify-content:space-between">
        <div>
            <small><a href="/clients">Clients &amp; Jobs</a> / @_job.ClientName / @_job.JobGroupName</small>
            <h1 style="margin:2px 0 0;font-size:1.5rem">@_job.Name</h1>
            <div class="lv-row" style="margin-top:6px">
                <LvBadge Tone="primary">@_job.Status</LvBadge>
                @{
                    var updatedFmt = Formatting.FormatDateTime(_job.UpdatedAtUtc, _job.TimeZoneIana, AppState.BrowserTimeZone);
                }
                <small style="color:var(--md-sys-color-on-surface-variant)">
                    Updated: @updatedFmt.JobLocalFormatted
                    @if (updatedFmt.ZonesDiffer && updatedFmt.BrowserLocalFormatted is not null)
                    {
                        <span> (Local: @updatedFmt.BrowserLocalFormatted)</span>
                    }
                </small>
            </div>
        </div>

        <div class="lv-row">
            @if (_lockStatus is not null)
            {
                @if (_lockStatus.IsHeldByCurrentSession)
                {
                    <LvBadge Tone="success">🔒 Editing Lock Active</LvBadge>
                    <LvButton Variant="outlined" Small="true" OnClick="ReleaseLockAsync">Finish / Release Lock</LvButton>
                }
                else if (_lockStatus.IsReservedForCurrentSession)
                {
                    <LvBadge Tone="warning">Your Turn Ready!</LvBadge>
                    <LvButton Small="true" OnClick="ClaimTurnAsync">Claim Turn &amp; Reload</LvButton>
                }
                else if (_lockStatus.IsCurrentSessionQueued)
                {
                    <LvBadge Tone="warning">Queued (Position @_lockStatus.QueuePosition)</LvBadge>
                    <LvButton Variant="outlined" Small="true" OnClick="CancelQueueAsync">Leave Queue</LvButton>
                }
                else if (_lockStatus.IsLocked)
                {
                    <LvBadge Tone="warning">Locked by @(_lockStatus.HolderDisplayName ?? "another user")</LvBadge>
                    <LvButton Variant="tonal" Small="true" OnClick="RequestModifyAsync">Join Modify Queue</LvButton>
                }
                else if (AppState.Can(ModuleKeys.Jobs, AccessLevel.Alter))
                {
                    <LvButton OnClick="RequestModifyAsync">Modify Job</LvButton>
                }
            }
        </div>
    </div>

    <LvErrorBanner Error="_error" />
    @if (!string.IsNullOrWhiteSpace(_notice))
    {
        <div class="lv-banner-success">@_notice</div>
    }

    <div class="lv-tabs" role="group" aria-label="Job sections">
        <LvButton Variant='@(_tab == "overview" ? "filled" : "outlined")' Pressed='@(_tab == "overview")' Small="true" OnClick='() => SwitchTabAsync("overview")'>Overview</LvButton>
        @if (AppState.Can(ModuleKeys.TimeTracking, AccessLevel.Read))
        { <LvButton Variant='@(_tab == "time" ? "filled" : "outlined")' Pressed='@(_tab == "time")' Small="true" OnClick='() => SwitchTabAsync("time")'>Time</LvButton> }
        @if (AppState.Can(ModuleKeys.JobDates, AccessLevel.Read))
        { <LvButton Variant='@(_tab == "dates" ? "filled" : "outlined")' Pressed='@(_tab == "dates")' Small="true" OnClick='() => SwitchTabAsync("dates")'>Dates</LvButton> }
        @if (AppState.Can(ModuleKeys.JobLineItems, AccessLevel.Read))
        { <LvButton Variant='@(_tab == "items" ? "filled" : "outlined")' Pressed='@(_tab == "items")' Small="true" OnClick='() => SwitchTabAsync("items")'>Line items</LvButton> }
        @if (AppState.Can(ModuleKeys.MoodBoards, AccessLevel.Read))
        { <LvButton Variant='@(_tab == "moodboards" ? "filled" : "outlined")' Pressed='@(_tab == "moodboards")' Small="true" OnClick='() => SwitchTabAsync("moodboards")'>Mood boards</LvButton> }
        @if (AppState.Can(ModuleKeys.Quotes, AccessLevel.Read) || AppState.Can(ModuleKeys.Invoices, AccessLevel.Read))
        { <LvButton Variant='@(_tab == "finance" ? "filled" : "outlined")' Pressed='@(_tab == "finance")' Small="true" OnClick='() => SwitchTabAsync("finance")'>Quotes &amp; invoices</LvButton> }
        @if (AppState.Can(ModuleKeys.Procurement, AccessLevel.Read) || AppState.Can(ModuleKeys.Receipts, AccessLevel.Read))
        { <LvButton Variant='@(_tab == "procurement" ? "filled" : "outlined")' Pressed='@(_tab == "procurement")' Small="true" OnClick='() => SwitchTabAsync("procurement")'>Procurement &amp; receipts</LvButton> }
    </div>

    @if (_tabLoading)
    {
        <p role="status">Loading section...</p>
    }
    else if (_tab == "overview")
    {
        <LvCard Title="Job details">
            @if (CanEditJob)
            {
            <div class="lv-grid-2">
                <LvTextField Label="Job Name" Required="true" Disabled="@(!CanEditJob)" Value="@_jobDraft.Name" ValueChanged="v => _jobDraft.Name = v ?? string.Empty" />
                <LvTextField Label="Status" Disabled="@(!CanEditJob)" Value="@_jobDraft.Status" ValueChanged="v => _jobDraft.Status = v ?? string.Empty" />
                <TimeZoneSelect @bind-Value="_jobDraft.TimeZoneIana" Disabled="@(!CanEditJob || _saving)" />
                <LvTextField Label="Default Currency" Required="true" Disabled="@(!CanEditJob)" Value="@_jobDraft.DefaultCurrency" ValueChanged="v => _jobDraft.DefaultCurrency = v ?? string.Empty" />
                <LvTextField Label="PO Number" Disabled="@(!CanEditJob)" Value="@_jobDraft.PoNumber" ValueChanged="v => _jobDraft.PoNumber = v" />
                <LvTextField Label="Hourly Rate (e.g. 165.00)" Disabled="@(!CanEditJob)" Value="@_jobDraft.HourlyRateInput" ValueChanged="v => _jobDraft.HourlyRateInput = v ?? string.Empty" />
            </div>
            <div style="margin-top:12px">
                <LvTextField Label="Notes" Multiline="true" Disabled="@(!CanEditJob)" Value="@_jobDraft.Notes" ValueChanged="v => _jobDraft.Notes = v" />
            </div>
            <div class="lv-row" style="margin-top:14px">
                <LvButton Loading="_saving" Disabled="@(!CanEditJob || !_jobDirty.IsDirty(_jobDraft) || string.IsNullOrWhiteSpace(_jobDraft.Name))" OnClick="SaveJobOverviewAsync">Save Changes</LvButton>
            </div>
            }
            else
            {
                <dl class="lv-details-grid">
                    <div><dt>Status</dt><dd>@_job.Status</dd></div>
                    <div><dt>Job time zone</dt><dd>@_job.TimeZoneIana</dd></div>
                    <div><dt>Currency</dt><dd>@_job.DefaultCurrency</dd></div>
                    <div><dt>PO number</dt><dd>@(_job.PoNumber ?? "Not set")</dd></div>
                    <div><dt>Hourly rate</dt><dd>@Formatting.FormatMoney(new MoneyCents(_job.DefaultHourlyRateCents, _job.DefaultCurrency))</dd></div>
                    <div><dt>Notes</dt><dd>@(_job.Notes ?? "Not set")</dd></div>
                </dl>
            }
        </LvCard>
    }
    else if (_tab == "time")
    {
        <LvCard Title="Job Time Tracker" Subtitle="Start/pause/resume/stop, cancel, Stop At / Resume At corrections, flat &amp; range entries">
            <HeaderActions>
                @if (AppState.Can(ModuleKeys.TimeTracking, AccessLevel.Alter))
                {
                <LvButton OnClick="() => StartTimerAsync(false)" Loading="_saving">▶ Start Timer</LvButton>
                <LvButton Variant="tonal" OnClick="() => _showFlatModal = true">+ Flat Entry</LvButton>
                <LvButton Variant="outlined" OnClick="() => _showRangeModal = true">+ Time Range</LvButton>
                }
            </HeaderActions>
            <ChildContent>
                <div class="lv-table-wrap">
                    <table class="lv-table">
                        <thead><tr><th>Date</th><th>Worker</th><th>Source / State</th><th>Duration</th><th>Description</th><th>Actions</th></tr></thead>
                        <tbody>
                            @foreach (var t in _timeEntries)
                            {
                                <tr>
                                    <td>@Formatting.FormatCalendarDate(t.WorkDate)</td>
                                    <td>@t.WorkerDisplayName</td>
                                    <td>
                                        <LvBadge Tone="@(t.State == "Running" ? "success" : t.State == "Paused" ? "warning" : t.State == "Cancelled" ? "error" : "primary")">
                                            @t.SourceType • @t.State
                                        </LvBadge>
                                        @if (t.HasIntentionalOverlap) { <LvBadge Tone="warning">Overlap</LvBadge> }
                                        @if (t.IsInvoiced) { <LvBadge Tone="primary">Invoiced</LvBadge> }
                                    </td>
                                    <td><strong>@Formatting.FormatDuration(t.LiveDurationSeconds)</strong></td>
                                    <td>@t.Description</td>
                                    <td class="lv-row">
                                        @if (t.State == "Running" && AppState.Can(ModuleKeys.TimeTracking, AccessLevel.Alter))
                                        {
                                            <LvButton Variant="tonal" Small="true" OnClick="() => PauseTimerAsync(t)">Pause</LvButton>
                                            <LvButton Small="true" OnClick="() => OpenTimeEdit(t, stop: true)">Stop</LvButton>
                                            <LvButton Variant="outlined" Small="true" OnClick='() => OpenAtTimeModal(t, "StopAt")'>Stop At…</LvButton>
                                            <LvButton Variant="danger" Small="true" OnClick="() => CancelTimerAsync(t)">Cancel</LvButton>
                                        }
                                        else if (t.State == "Paused" && AppState.Can(ModuleKeys.TimeTracking, AccessLevel.Alter))
                                        {
                                            <LvButton Small="true" OnClick="() => ResumeTimerAsync(t)">Resume</LvButton>
                                            <LvButton Variant="outlined" Small="true" OnClick='() => OpenAtTimeModal(t, "ResumeAt")'>Resume At…</LvButton>
                                            <LvButton Variant="tonal" Small="true" OnClick="() => OpenTimeEdit(t, stop: true)">Stop</LvButton>
                                            <LvButton Variant="danger" Small="true" OnClick="() => CancelTimerAsync(t)">Cancel</LvButton>
                                        }
                                        @if (t.State == "Stopped" && !t.IsInvoiced && AppState.Can(ModuleKeys.TimeTracking, AccessLevel.Alter))
                                        {
                                            <LvButton Variant="tonal" Small="true" OnClick="() => OpenTimeEdit(t, stop: false)">Edit</LvButton>
                                        }
                                        @if (AppState.Can(ModuleKeys.TimeTracking, AccessLevel.Delete))
                                        {
                                            <LvButton Variant="outlined" Small="true" OnClick="() => DeleteTimeAsync(t)">Delete</LvButton>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </ChildContent>
        </LvCard>
    }
    else if (_tab == "dates")
    {
        <LvCard Title="Job Dates &amp; Milestones" Subtitle="Requires Modify lock to add or edit milestones">
            <HeaderActions>
                <LvButton Small="true" Disabled="@(!CanEditJob)" OnClick="() => _showDateModal = true">+ Add Date / Milestone</LvButton>
            </HeaderActions>
            <ChildContent>
                <div class="lv-table-wrap">
                    <table class="lv-table">
                        <thead><tr><th>Label</th><th>Category</th><th>Date</th><th>Status</th><th>Forecast</th></tr></thead>
                        <tbody>
                            @foreach (var d in _dates)
                            {
                                <tr>
                                    <td><strong>@d.Label</strong><div><small>@d.Description</small></div></td>
                                    <td><LvBadge>@d.CategoryLabel</LvBadge></td>
                                    <td>@(d.CalendarDate.HasValue ? Formatting.FormatCalendarDate(d.CalendarDate.Value) : d.OccurredAtUtc?.ToString("u"))</td>
                                    <td><LvBadge Tone="@(d.IsActual ? "success" : "warning")">@(d.IsActual ? "Actual" : "Planned") • @d.Status</LvBadge></td>
                                    <td>@(d.ForecastAmountCents.HasValue ? $"{d.ForecastDirection}: {Formatting.FormatMoney(new MoneyCents(d.ForecastAmountCents.Value, d.ForecastCurrency ?? _job.DefaultCurrency))}" : "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </ChildContent>
        </LvCard>
    }
    else if (_tab == "items")
    {
        <LvCard Title="Job Sourced Line Items" Subtitle="Job-specific furniture &amp; decor requirements with full audit history (requires Modify lock)">
            <HeaderActions>
                <LvButton Small="true" Loading="_saving"
                          Disabled="@(!AppState.Can(ModuleKeys.Jobs, AccessLevel.Alter) || !AppState.Can(ModuleKeys.JobLineItems, AccessLevel.Alter))"
                          OnClick="OpenLineItemAsync">+ Add Line Item</LvButton>
            </HeaderActions>
            <ChildContent>
                <div class="lv-table-wrap">
                    <table class="lv-table">
                        <thead><tr><th>Item / Room</th><th>Requirements</th><th>Qty</th><th>Cost</th><th>Sell Price</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var li in _lineItems)
                            {
                                <tr>
                                    <td><strong>@li.Title</strong><div><small>@li.RoomOrArea</small></div></td>
                                    <td>@li.RequirementsNote</td>
                                    <td>@((li.QuantityMilli / 1000m).ToString("0.###")) @li.Unit</td>
                                    <td>@Formatting.FormatMoney(new MoneyCents(li.CostCents, li.Currency))</td>
                                    <td><strong>@Formatting.FormatMoney(new MoneyCents(li.UnitSellPriceCents, li.Currency))</strong></td>
                                    <td>
                                        <LvButton Variant="outlined" Small="true" OnClick="() => ShowTimelineAsync(li.Id)">History</LvButton>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </ChildContent>
        </LvCard>
    }
    else if (_tab == "moodboards")
    {
        <LvCard Title="Mood Boards &amp; Branded Canvases" Subtitle="Multiple branded canvases per board — add job resources, uploads or text, then Save as PDF">
            <HeaderActions>
                <LvButton Small="true" OnClick="() => _showNewBoardModal = true">+ New Mood Board</LvButton>
            </HeaderActions>
            <ChildContent>
                @if (_moodBoards.Count == 0)
                {
                    <p>No mood boards yet. Create one to start arranging branded canvases.</p>
                }
                else
                {
                    <div class="lv-row" style="margin-bottom:14px">
                        @foreach (var b in _moodBoards)
                        {
                            <LvButton Variant="@(b.Id == _selectedBoard?.Id ? "filled" : "tonal")" Small="true" OnClick="() => SelectBoard(b)">@b.Name (@b.Canvases.Count)</LvButton>
                        }
                    </div>

                    @if (_selectedBoard is not null)
                    {
                        <div class="lv-row" style="margin-bottom:12px">
                            @foreach (var c in _selectedBoard.Canvases)
                            {
                                <LvButton Variant="@(c.Id == _selectedCanvas?.Id ? "filled" : "outlined")" Small="true" OnClick="() => SelectCanvas(c)">@c.Name</LvButton>
                            }
                            <LvButton Variant="tonal" Small="true" OnClick="AddCanvasToBoardAsync">+ Add Canvas</LvButton>
                            <LvButton Variant="outlined" Small="true" OnClick="() => ExportMoodBoardPdfAsync(false)">Save Full Board PDF</LvButton>
                            @if (_selectedCanvas is not null)
                            {
                                <LvButton Variant="outlined" Small="true" OnClick="() => ExportMoodBoardPdfAsync(true)">Save This Canvas PDF</LvButton>
                            }
                        </div>

                        @if (_selectedCanvas is not null)
                        {
                            <div class="lv-row" style="margin-bottom:12px">
                                <LvButton Variant="tonal" Small="true" OnClick="AddTextToCanvas">+ Add Text</LvButton>
                                <LvButton Variant="tonal" Small="true" OnClick="() => _showCanvasImagePicker = true">+ Add Image (Library / Upload)</LvButton>
                                <LvButton Small="true" Loading="_saving" OnClick="SaveCanvasLayoutAsync">Save Canvas Layout</LvButton>
                            </div>

                            <div class="lv-canvas-stage" style="background:@_selectedCanvas.BackgroundColorHex">
                                <div class="lv-canvas-brand-bar" style="background:@_selectedCanvas.Branding.PrimaryColorHex">
                                    <span>@_selectedCanvas.Branding.CompanyName</span>
                                    <span>@_selectedBoard.Name • @_selectedCanvas.Name</span>
                                </div>
                                @foreach (var el in _canvasElements.OrderBy(e => e.ZIndex))
                                {
                                    var leftPct = (el.X / _selectedCanvas.WidthPx * 100.0).ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
                                    var topPct = (el.Y / _selectedCanvas.HeightPx * 100.0).ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
                                    var wPct = (el.Width / _selectedCanvas.WidthPx * 100.0).ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
                                    var hPct = (el.Height / _selectedCanvas.HeightPx * 100.0).ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
                                    <div class="lv-canvas-item @(el.Id == _selectedElementId ? "selected" : "")"
                                         style="left:@(leftPct)%;top:@(topPct)%;width:@(wPct)%;height:@(hPct)%;z-index:@el.ZIndex"
                                         @onclick="() => _selectedElementId = el.Id">
                                        @if (el.ElementType == MoodBoardElementType.Image && el.ImageAssetId.HasValue)
                                        {
                                            <img src="/api/images/@el.ImageAssetId/content" alt="@(el.Caption ?? "Mood board image")" style="width:100%;height:100%;object-fit:contain" />
                                        }
                                        else
                                        {
                                            <div style="padding:8px;color:@el.TextColorHex;font-size:0.95rem;font-weight:600">@el.TextContent</div>
                                        }
                                    </div>
                                }
                            </div>

                            <h3 style="margin:14px 0 6px;font-size:0.98rem">Accessible Element List &amp; Positioning</h3>
                            <div class="lv-table-wrap">
                                <table class="lv-table">
                                    <thead><tr><th>Type / Content</th><th>X</th><th>Y</th><th>W</th><th>H</th><th>Layer (Z)</th><th></th></tr></thead>
                                    <tbody>
                                        @foreach (var el in _canvasElements)
                                        {
                                            <tr>
                                                <td>
                                                    @if (el.ElementType == MoodBoardElementType.Text)
                                                    {
                                                        <input class="lv-input" value="@el.TextContent" @oninput="e => UpdateEl(el.Id, x => x with { TextContent = e.Value?.ToString() })" />
                                                    }
                                                    else { <LvBadge Tone="primary">Image</LvBadge> <span>@el.Caption</span> }
                                                </td>
                                                <td><input class="lv-input" style="width:72px" type="number" value="@el.X" @onchange="e => UpdateEl(el.Id, x => x with { X = ParseDouble(e.Value, x.X) })" /></td>
                                                <td><input class="lv-input" style="width:72px" type="number" value="@el.Y" @onchange="e => UpdateEl(el.Id, x => x with { Y = ParseDouble(e.Value, x.Y) })" /></td>
                                                <td><input class="lv-input" style="width:72px" type="number" value="@el.Width" @onchange="e => UpdateEl(el.Id, x => x with { Width = Math.Max(40, ParseDouble(e.Value, x.Width)) })" /></td>
                                                <td><input class="lv-input" style="width:72px" type="number" value="@el.Height" @onchange="e => UpdateEl(el.Id, x => x with { Height = Math.Max(40, ParseDouble(e.Value, x.Height)) })" /></td>
                                                <td><input class="lv-input" style="width:64px" type="number" value="@el.ZIndex" @onchange="e => UpdateEl(el.Id, x => x with { ZIndex = (int)ParseDouble(e.Value, x.ZIndex) })" /></td>
                                                <td><LvButton Variant="outlined" Small="true" OnClick="() => _canvasElements.RemoveAll(x => x.Id == el.Id)">Remove</LvButton></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                }
            </ChildContent>
        </LvCard>
    }
    else if (_tab == "finance")
    {
        <LvCard Title="Quotes &amp; Invoices" Subtitle="Manual lines, job items, billable time or total-only — with Word .docx template &amp; PDF exports">
            <HeaderActions>
                @if (AppState.Can(ModuleKeys.Quotes, AccessLevel.Alter))
                { <LvButton Small="true" OnClick="() => OpenNewDocModal(FinancialDocumentType.Quote)">+ New Quote</LvButton> }
                @if (AppState.Can(ModuleKeys.Invoices, AccessLevel.Alter))
                { <LvButton Variant="tonal" Small="true" OnClick="() => OpenNewDocModal(FinancialDocumentType.Invoice)">+ New Invoice</LvButton> }
            </HeaderActions>
            <ChildContent>
                <div class="lv-table-wrap">
                    <table class="lv-table">
                        <thead><tr><th>Number</th><th>Type / Status</th><th>Mode</th><th>Applied Total</th><th>Actions</th></tr></thead>
                        <tbody>
                            @foreach (var doc in _documents)
                            {
                                <tr>
                                    <td><strong>@doc.DocumentNumber</strong></td>
                                    <td><LvBadge Tone="@(doc.Status == "Issued" ? "success" : "warning")">@doc.DocumentType • @doc.Status</LvBadge></td>
                                    <td><small>@doc.CalculationMode</small></td>
                                    <td><strong>@Formatting.FormatMoney(new MoneyCents(doc.AppliedTotalCents, doc.Currency))</strong></td>
                                    <td class="lv-row">
                                        <LvButton Variant="tonal" Small="true" OnClick="() => DownloadDocxAsync(doc)">Word .docx</LvButton>
                                        <LvButton Small="true" OnClick="() => DownloadPdfAsync(doc)">Save PDF</LvButton>
                                        @if (doc.DocumentType == FinancialDocumentType.Quote)
                                        {
                                            <LvButton Variant="outlined" Small="true" OnClick="() => ConvertToInvoiceAsync(doc.Id)">To Invoice</LvButton>
                                        }
                                        @if (doc.Status == "Draft")
                                        {
                                            <LvButton Variant="outlined" Small="true" OnClick="() => IssueDocumentAsync(doc)">Issue</LvButton>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </ChildContent>
        </LvCard>
    }
    else if (_tab == "procurement")
    {
        <div class="lv-grid-2">
            @if (AppState.Can(ModuleKeys.Procurement, AccessLevel.Read))
            {
            <LvCard Title="Procurement &amp; Orders" Subtitle="Track supplier orders, shipping, installation &amp; payments (requires Modify lock)">
                <HeaderActions>
                    @if (AppState.Can(ModuleKeys.Procurement, AccessLevel.Alter))
                    { <LvButton Small="true" Disabled="@(!CanEditJob)" OnClick="() => _showProcModal = true">+ Add Order</LvButton> }
                </HeaderActions>
                <ChildContent>
                    @foreach (var p in _procurement)
                    {
                        <div class="lv-card lv-card-tonal" style="margin-bottom:10px;padding:12px">
                            <div class="lv-row" style="justify-content:space-between">
                                <strong>@p.SupplierName (@p.OrderReference)</strong>
                                <LvBadge Tone="primary">@p.Status</LvBadge>
                            </div>
                            <small>Total: @Formatting.FormatMoney(new MoneyCents(p.TotalCostCents, p.Currency)) • Paid: @Formatting.FormatMoney(new MoneyCents(p.PaidCents, p.Currency)) • Outstanding: @Formatting.FormatMoney(new MoneyCents(p.OutstandingCents, p.Currency))</small>
                        </div>
                    }
                </ChildContent>
            </LvCard>
            }

            @if (AppState.Can(ModuleKeys.Receipts, AccessLevel.Read))
            {
            <LvCard Title="Paper Receipts" Subtitle="Capture with device camera or upload image (stored at ≤1080p)">
                <HeaderActions>
                    @if (AppState.Can(ModuleKeys.Receipts, AccessLevel.Alter))
                    { <LvButton Small="true" OnClick="() => _showReceiptModal = true">+ Capture / Upload Receipt</LvButton> }
                </HeaderActions>
                <ChildContent>
                    @foreach (var r in _receipts)
                    {
                        <div class="lv-row" style="justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--md-sys-color-outline-variant)">
                            <div>
                                <strong>@r.MerchantName</strong>
                                <div><small>@Formatting.FormatCalendarDate(r.ReceiptDate) • @Formatting.FormatMoney(new MoneyCents(r.AmountCents, r.Currency))</small></div>
                            </div>
                            <a class="lv-btn lv-btn-outlined lv-btn-sm" href="/api/images/@r.ImageAssetId/content" target="_blank">View Photo</a>
                        </div>
                    }
                </ChildContent>
            </LvCard>
            }
        </div>
    }

    <LvDialog Open="@(_timeEditTarget is not null)" Title="@(_stoppingTimer ? "Stop timer" : "Edit recorded time")" OnClose="CloseTimeEdit">
        <ChildContent>
            <LvErrorBanner Error="_timeEditError" />
            <LvTextField Label="Description" Multiline="true" Rows="4" @bind-Value="_timeEditDescription" Disabled="_saving" />
            @if (!_stoppingTimer)
            {
                <div class="lv-grid-2">
                    <label class="lv-field">Work date<input class="lv-input" type="date" @bind="_timeEditDate" disabled="@_saving" /></label>
                    <label class="lv-field">Worked duration (seconds)<input class="lv-input" type="number" min="1" @bind="_timeEditSeconds" @bind:event="oninput" disabled="@_saving" /></label>
                </div>
                <label class="lv-row"><input type="checkbox" @bind="_timeEditBillable" disabled="@_saving" /> Billable</label>
                <small>Changing the worked duration keeps the original timer intervals in history.</small>
            }
        </ChildContent>
        <Actions>
            <LvButton Variant="outlined" Disabled="_saving" OnClick="CloseTimeEdit">Cancel</LvButton>
            <LvButton Loading="_saving" Disabled="@(!CanSaveTimeEdit)" OnClick="SaveTimeEditAsync">@(_stoppingTimer ? "Stop timer" : "Save changes")</LvButton>
        </Actions>
    </LvDialog>

    <!-- Multiple Running Timers Modal -->
    <LvDialog Open="_showMultiTimerModal" Title="Another Timer Is Currently Running" OnClose="() => _showMultiTimerModal = false">
        <ChildContent>
            <p>You currently have running timer(s) on another job:</p>
            <ul>
                @foreach (var rt in _runningTimersConflict)
                {
                    <li><strong>@rt.JobName</strong> — @Formatting.FormatDuration(rt.LiveDurationSeconds)</li>
                }
            </ul>
            <p>Would you like to stop the existing timer(s) and start this one, or keep multiple timers running concurrently?</p>
        </ChildContent>
        <Actions>
            <LvButton Variant="outlined" OnClick="() => _showMultiTimerModal = false">Cancel</LvButton>
            <LvButton Variant="tonal" Loading="_saving" OnClick='() => ResolveMultiTimerAsync("KeepRunning")'>Keep Running &amp; Start</LvButton>
            <LvButton Loading="_saving" OnClick='() => ResolveMultiTimerAsync("StopExisting")'>Stop Existing &amp; Start</LvButton>
        </Actions>
    </LvDialog>

    <!-- Stop At / Resume At Preview Modal -->
    <LvDialog Open="_showAtTimeModal" Title="@(_atTimeAction == "StopAt" ? "Stop Timer At Specific Time" : "Resume Timer At Specific Time")" OnClose="() => _showAtTimeModal = false">
        <ChildContent>
            <div style="display:flex;flex-direction:column;gap:12px">
                <div class="lv-field">
                    <label class="lv-label">Effective Local Time (must be in the past or now)</label>
                    <input class="lv-input" type="datetime-local" @bind="_atTimeLocal" />
                </div>
                <LvButton Variant="tonal" Small="true" OnClick="PreviewAtTimeAsync">Preview Resulting Duration</LvButton>
                @if (_atTimePreview is not null)
                {
                    <div class="lv-banner-success">
                        Resulting worked duration to date: <strong>@Formatting.FormatDuration(_atTimePreview.ResultingDurationSeconds)</strong>
                    </div>
                    @if (_atTimePreview.HasOverlapWarning)
                    {
                        <div class="lv-banner-warning">@_atTimePreview.OverlapWarningMessage</div>
                        <label class="lv-row"><input type="checkbox" @bind="_atTimeConfirmOverlap" /> Confirm intentional overlap</label>
                    }
                }
            </div>
        </ChildContent>
        <Actions>
            <LvButton Variant="outlined" OnClick="() => _showAtTimeModal = false">Cancel</LvButton>
            <LvButton Loading="_saving" Disabled="@(_atTimePreview is null)" OnClick="ApplyAtTimeAsync">Confirm &amp; Apply</LvButton>
        </Actions>
    </LvDialog>

    <!-- Flat Time Entry Modal -->
    <LvDialog Open="_showFlatModal" Title="Add Flat Time Entry" OnClose="() => _showFlatModal = false">
        <ChildContent>
            <div style="display:flex;flex-direction:column;gap:12px">
                <div class="lv-field"><label class="lv-label">Work Date</label><input class="lv-input" type="date" @bind="_flatDate" /></div>
                <LvTextField Label="Duration (minutes)" InputType="number" Required="true" Value="@_flatMinutes" ValueChanged="v => _flatMinutes = v ?? string.Empty" />
                <LvTextField Label="Description" Value="@_flatDesc" ValueChanged="v => _flatDesc = v" />
            </div>
        </ChildContent>
        <Actions>
            <LvButton Variant="outlined" OnClick="() => _showFlatModal = false">Cancel</LvButton>
            <LvButton Loading="_saving" OnClick="SaveFlatTimeAsync">Add Time</LvButton>
        </Actions>
    </LvDialog>

    <!-- Range Time Entry Modal -->
    <LvDialog Open="_showRangeModal" Title="Add Time Range Entry" OnClose="() => _showRangeModal = false">
        <ChildContent>
            <div style="display:flex;flex-direction:column;gap:12px">
                <div class="lv-field"><label class="lv-label">Start Time</label><input class="lv-input" type="datetime-local" @bind="_rangeStart" /></div>
                <div class="lv-field"><label class="lv-label">End Time</label><input class="lv-input" type="datetime-local" @bind="_rangeEnd" /></div>
                <LvTextField Label="Description" Value="@_rangeDesc" ValueChanged="v => _rangeDesc = v" />
                <label class="lv-row"><input type="checkbox" @bind="_rangeConfirmOverlap" /> Confirm if overlapping another entry</label>
            </div>
        </ChildContent>
        <Actions>
            <LvButton Variant="outlined" OnClick="() => _showRangeModal = false">Cancel</LvButton>
            <LvButton Loading="_saving" OnClick="SaveRangeTimeAsync">Add Range</LvButton>
        </Actions>
    </LvDialog>

    <!-- Add Milestone Modal -->
    <LvDialog Open="_showDateModal" Title="Add Job Date / Milestone" OnClose="() => _showDateModal = false">
        <ChildContent>
            <div style="display:flex;flex-direction:column;gap:12px">
                <LvTextField Label="Label" Required="true" Value="@_dateLabel" ValueChanged="v => _dateLabel = v ?? string.Empty" Placeholder="e.g. Installation Day" />
                <LvTextField Label="Category" Value="@_dateCat" ValueChanged="v => _dateCat = v ?? string.Empty" />
                <div class="lv-field"><label class="lv-label">Calendar Date</label><input class="lv-input" type="date" @bind="_dateVal" /></div>
                <LvTextField Label="Optional Forecast Amount (e.g. 5000.00)" Value="@_dateForecastAmt" ValueChanged="v => _dateForecastAmt = v ?? string.Empty" />
                <div class="lv-field">
                    <label class="lv-label">Forecast Direction</label>
                    <select class="lv-select" @bind="_dateForecastDir"><option value="None">None</option><option value="Revenue">Revenue</option><option value="Cost">Cost</option></select>
                </div>
            </div>
        </ChildContent>
        <Actions>
            <LvButton Variant="outlined" OnClick="() => _showDateModal = false">Cancel</LvButton>
            <LvButton Loading="_saving" Disabled="@string.IsNullOrWhiteSpace(_dateLabel)" OnClick="SaveDateAsync">Save Milestone</LvButton>
        </Actions>
    </LvDialog>

    <!-- Add Job Line Item Modal -->
    <LvDialog Open="_showLineItemModal" Title="Add Job Line Item" OnClose="() => _showLineItemModal = false">
        <ChildContent>
            <LvErrorBanner Error="_error" />
            <div style="display:flex;flex-direction:column;gap:12px">
                <LvTextField Label="Title" Required="true" Value="@_liTitle" ValueChanged="v => _liTitle = v ?? string.Empty" />
                <LvTextField Label="Room / Area" Value="@_liRoom" ValueChanged="v => _liRoom = v" />
                <LvTextField Label="Specific Requirements (e.g. Black frame, 500x760mm)" Multiline="true" Value="@_liReq" ValueChanged="v => _liReq = v" />
                <div class="lv-grid-3">
                    <LvTextField Label="Qty" InputType="number" Value="@_liQty" ValueChanged="v => _liQty = v ?? string.Empty" />
                    <LvTextField Label="Our Cost" Value="@_liCost" ValueChanged="v => _liCost = v ?? string.Empty" />
                    <LvTextField Label="Sell Price" Value="@_liSell" ValueChanged="v => _liSell = v ?? string.Empty" />
                </div>
            </div>
        </ChildContent>
        <Actions>
            <LvButton Variant="outlined" OnClick="() => _showLineItemModal = false">Cancel</LvButton>
            <LvButton Loading="_saving" Disabled="@string.IsNullOrWhiteSpace(_liTitle)" OnClick="SaveLineItemAsync">Add Item</LvButton>
        </Actions>
    </LvDialog>

    <!-- Line Item Audit Timeline Modal -->
    <LvDialog Open="_showTimelineModal" Title="Line Item Audit History" OnClose="() => _showTimelineModal = false">
        @foreach (var a in _timelineEntries)
        {
            <div class="lv-card lv-card-tonal" style="margin-bottom:8px;padding:10px">
                <strong>@a.Operation</strong> by @a.ActorDisplayName at @a.OccurredAtUtc.ToString("u")
            </div>
        }
    </LvDialog>

    <!-- New Mood Board Modal -->
    <LvDialog Open="_showNewBoardModal" Title="Create Mood Board" OnClose="() => _showNewBoardModal = false">
        <ChildContent>
            <LvTextField Label="Board Name" Required="true" Value="@_newBoardName" ValueChanged="v => _newBoardName = v ?? string.Empty" />
        </ChildContent>
        <Actions>
            <LvButton Variant="outlined" OnClick="() => _showNewBoardModal = false">Cancel</LvButton>
            <LvButton Loading="_saving" Disabled="@string.IsNullOrWhiteSpace(_newBoardName)" OnClick="CreateBoardAsync">Create Board</LvButton>
        </Actions>
    </LvDialog>

    <!-- Canvas Image Picker / External Upload Modal -->
    <LvDialog Open="_showCanvasImagePicker" Title="Add Image to Canvas" OnClose="() => _showCanvasImagePicker = false">
        <div style="display:flex;flex-direction:column;gap:12px">
            <strong>Upload External Image (auto-resized to ≤1080p)</strong>
            <InputFile OnChange="UploadImageToCanvasAsync" accept="image/jpeg,image/png,image/webp" />
            <strong>Or Select from Library / Job Resources</strong>
            <div class="lv-grid-3">
                @foreach (var img in _availableImages)
                {
                    <div class="lv-card" style="padding:8px;cursor:pointer" @onclick="() => AddLibraryImageToCanvas(img)">
                        <img src="/api/images/@img.Id/content?thumb=true" alt="@img.Title" style="width:100%;height:80px;object-fit:cover;border-radius:4px" />
                        <small>@img.Title</small>
                    </div>
                }
            </div>
        </div>
    </LvDialog>

    <!-- New Quote / Invoice Modal -->
    <LvDialog Open="_showNewDocModal" Title="@($"Create {_newDocType}")" OnClose="() => _showNewDocModal = false">
        <ChildContent>
            <div style="display:flex;flex-direction:column;gap:12px">
                <div class="lv-field">
                    <label class="lv-label">Calculation Mode</label>
                    <select class="lv-select" @bind="_newDocMode">
                        <option value="LineCalculated">Line-Based (Calculated Total + GST)</option>
                        <option value="TotalOnly">Manual Total-Only (No Lines)</option>
                    </select>
                </div>
                @if (_newDocMode == "TotalOnly")
                {
                    <LvTextField Label="Manual Total Amount" Required="true" Value="@_newDocManualTotal" ValueChanged="v => _newDocManualTotal = v ?? string.Empty" />
                }
                else
                {
                    <LvTextField Label="Manual Line Description" Value="@_newDocLineTitle" ValueChanged="v => _newDocLineTitle = v ?? string.Empty" Placeholder="e.g. Design Consultation Fee" />
                    <div class="lv-grid-2">
                        <LvTextField Label="Unit Price" Value="@_newDocLinePrice" ValueChanged="v => _newDocLinePrice = v ?? string.Empty" />
                        <LvTextField Label="Quantity" InputType="number" Value="@_newDocLineQty" ValueChanged="v => _newDocLineQty = v ?? string.Empty" />
                    </div>
                    <LvTextField Label="Discount Amount (optional)" Value="@_newDocDiscount" ValueChanged="v => _newDocDiscount = v ?? string.Empty" />
                    @if (AppState.Can(ModuleKeys.JobLineItems, AccessLevel.Read))
                    {
                        <label class="lv-row" style="font-size:0.86rem">
                            <input type="checkbox" @bind="_newDocIncludeJobItems" disabled="@(!_lineItemsLoaded)" /> Include all @_lineItems.Count job line item(s)
                        </label>
                    }
                }
                <LvTextField Label="Notes" Multiline="true" Value="@_newDocNotes" ValueChanged="v => _newDocNotes = v" />
            </div>
        </ChildContent>
        <Actions>
            <LvButton Variant="outlined" OnClick="() => _showNewDocModal = false">Cancel</LvButton>
            <LvButton Loading="_saving" OnClick="CreateDocumentAsync">Create @_newDocType</LvButton>
        </Actions>
    </LvDialog>

    <!-- New Procurement Modal -->
    <LvDialog Open="_showProcModal" Title="Add Procurement Order" OnClose="() => _showProcModal = false">
        <ChildContent>
            <div style="display:flex;flex-direction:column;gap:12px">
                <LvTextField Label="Supplier Name" Required="true" Value="@_procSupplier" ValueChanged="v => _procSupplier = v ?? string.Empty" />
                <LvTextField Label="Order Reference" Value="@_procRef" ValueChanged="v => _procRef = v" />
                <LvTextField Label="Total Cost" Value="@_procCost" ValueChanged="v => _procCost = v ?? string.Empty" />
                <LvTextField Label="Shipping / Installation Notes" Multiline="true" Value="@_procNotes" ValueChanged="v => _procNotes = v" />
            </div>
        </ChildContent>
        <Actions>
            <LvButton Variant="outlined" OnClick="() => _showProcModal = false">Cancel</LvButton>
            <LvButton Loading="_saving" Disabled="@string.IsNullOrWhiteSpace(_procSupplier)" OnClick="SaveProcurementAsync">Save Order</LvButton>
        </Actions>
    </LvDialog>

    <!-- Upload Receipt Modal (supports device camera via capture attribute) -->
    <LvDialog Open="_showReceiptModal" Title="Capture or Upload Paper Receipt" OnClose="CloseReceiptAsync">
        <ChildContent>
            <div style="display:flex;flex-direction:column;gap:12px">
                <LvErrorBanner Error="_error" />
                <div class="lv-banner-warning" style="font-size:0.82rem">Receipt photos are resized to at most 1080p; check legibility after upload.</div>
                <LvTextField Label="Merchant Name" Required="true" Value="@_recMerchant" ValueChanged="v => _recMerchant = v ?? string.Empty" />
                <div class="lv-grid-2">
                    <div class="lv-field"><label class="lv-label">Receipt Date</label><input class="lv-input" type="date" @bind="_recDate" /></div>
                    <LvTextField Label="Amount" Required="true" Value="@_recAmount" ValueChanged="v => _recAmount = v ?? string.Empty" />
                </div>
                <div class="lv-field">
                    <label class="lv-label" for="receipt-photo-file">Choose an existing photo</label>
                    <InputFile id="receipt-photo-file" OnChange="OnReceiptFileSelected" accept="image/jpeg,image/png,image/webp" disabled="@_saving" />
                </div>
                <div class="lv-row">
                    <LvButton Variant="tonal" Loading="_cameraLoading" Disabled="_saving" OnClick="StartReceiptCameraAsync">@(_cameraPhoto ? "Retake photo" : "Open camera")</LvButton>
                    @if (_cameraLive)
                    {
                        <LvButton Disabled="_saving" OnClick="TakeReceiptPhotoAsync">Take photo</LvButton>
                    }
                </div>
                <video @ref="_receiptVideo" class="lv-receipt-preview" hidden="@(!_cameraLive)" muted playsinline aria-label="Live camera preview"></video>
                <canvas @ref="_receiptCanvas" class="lv-receipt-preview" hidden="@(!_cameraPhoto)" aria-label="Captured receipt preview"></canvas>
                @if (_cameraError is not null)
                {
                    <p class="lv-banner-warning" role="status">@_cameraError</p>
                }
            </div>
        </ChildContent>
        <Actions>
            <LvButton Variant="outlined" Disabled="_saving" OnClick="CloseReceiptAsync">Cancel</LvButton>
            <LvButton Loading="_saving" Disabled="@((_recBytes is null && !_cameraPhoto) || string.IsNullOrWhiteSpace(_recMerchant))" OnClick="SaveReceiptAsync">Upload Receipt</LvButton>
        </Actions>
    </LvDialog>
}

@code {
    [Parameter] public Guid JobId { get; set; }

    private sealed class JobDraft
    {
        public string Name { get; set; } = string.Empty;
        public string Status { get; set; } = "Active";
        public string TimeZoneIana { get; set; } = "Australia/Sydney";
        public string DefaultCurrency { get; set; } = "AUD";
        public string? PoNumber { get; set; }
        public string HourlyRateInput { get; set; } = "0.00";
        public string? Notes { get; set; }
    }

    private JobDto? _job;
    private EditLockStatusDto? _lockStatus;
    private JobDraft _jobDraft = new();
    private readonly LvDirtyTracker<JobDraft> _jobDirty = new();
    private string _tab = "overview";
    private bool _tabLoading;
    private bool _loading = true;
    private bool _saving;
    private ApiErrorResponse? _error;
    private string? _notice;

    private List<JobDateDto> _dates = [];
    private List<TimeEntryDto> _timeEntries = [];
    private List<JobLineItemDto> _lineItems = [];
    private bool _lineItemsLoaded;
    private List<MoodBoardDto> _moodBoards = [];
    private MoodBoardDto? _selectedBoard;
    private MoodBoardCanvasDto? _selectedCanvas;
    private List<MoodBoardElementDto> _canvasElements = [];
    private Guid? _selectedElementId;
    private List<ImageAssetDto> _availableImages = [];
    private List<FinancialDocumentDto> _documents = [];
    private List<ProcurementItemDto> _procurement = [];
    private List<ReceiptDto> _receipts = [];

    // Modals state
    private bool _showMultiTimerModal;
    private List<RunningTimerSummaryDto> _runningTimersConflict = [];
    private bool _showAtTimeModal;
    private TimeEntryDto? _atTimeTarget;
    private string _atTimeAction = "StopAt";
    private DateTime _atTimeLocal = DateTime.Now.AddMinutes(-5);
    private TimerAdjustmentPreviewDto? _atTimePreview;
    private bool _atTimeConfirmOverlap;

    private bool _showFlatModal;
    private DateOnly _flatDate = DateOnly.FromDateTime(DateTime.Now);
    private string _flatMinutes = "60";
    private string? _flatDesc;

    private bool _showRangeModal;
    private DateTime _rangeStart = DateTime.Now.AddHours(-1);
    private DateTime _rangeEnd = DateTime.Now;
    private string? _rangeDesc;
    private bool _rangeConfirmOverlap;

    private bool _showDateModal;
    private string _dateLabel = string.Empty;
    private string _dateCat = "Milestone";
    private DateOnly _dateVal = DateOnly.FromDateTime(DateTime.Now);
    private string _dateForecastAmt = string.Empty;
    private string _dateForecastDir = "None";

    private bool _showLineItemModal;
    private string _liTitle = string.Empty;
    private string? _liRoom;
    private string? _liReq;
    private string _liQty = "1";
    private string _liCost = "0.00";
    private string _liSell = "0.00";

    private bool _showTimelineModal;
    private List<AuditEntryDto> _timelineEntries = [];

    private bool _showNewBoardModal;
    private string _newBoardName = string.Empty;
    private bool _showCanvasImagePicker;

    private bool _showNewDocModal;
    private FinancialDocumentType _newDocType = FinancialDocumentType.Quote;
    private string _newDocMode = "LineCalculated";
    private string _newDocManualTotal = "0.00";
    private string _newDocLineTitle = string.Empty;
    private string _newDocLinePrice = "0.00";
    private string _newDocLineQty = "1";
    private string _newDocDiscount = "0.00";
    private bool _newDocIncludeJobItems = true;
    private string? _newDocNotes;

    private bool _showProcModal;
    private string _procSupplier = string.Empty;
    private string? _procRef;
    private string _procCost = "0.00";
    private string? _procNotes;

    private bool _showReceiptModal;
    private string _recMerchant = string.Empty;
    private DateOnly _recDate = DateOnly.FromDateTime(DateTime.Now);
    private string _recAmount = "0.00";
    private byte[]? _recBytes;
    private string _recFileName = "receipt.jpg";
    private string _recContentType = "image/jpeg";
    private ElementReference _receiptVideo;
    private ElementReference _receiptCanvas;
    private bool _cameraLoading;
    private bool _cameraLive;
    private bool _cameraPhoto;
    private string? _cameraError;
    private int _cameraAttempt;

    private bool CanEditJob => _lockStatus?.IsHeldByCurrentSession == true && AppState.Can(ModuleKeys.Jobs, AccessLevel.Alter);

    protected override Task OnParametersSetAsync() => LoadAllAsync();

    private async Task LoadAllAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var jResp = await Api.GetAsync<JobDto>($"/api/jobs/{JobId}");
            if (!jResp.IsSuccess || jResp.Data is null) { _error = jResp.Error; return; }
            _job = jResp.Data;
            _jobDraft = new JobDraft
            {
                Name = _job.Name,
                Status = _job.Status,
                TimeZoneIana = _job.TimeZoneIana,
                DefaultCurrency = _job.DefaultCurrency,
                PoNumber = _job.PoNumber,
                HourlyRateInput = new MoneyCents(_job.DefaultHourlyRateCents, _job.DefaultCurrency).ToHumanDecimal().ToString("F2"),
                Notes = _job.Notes
            };
            _jobDirty.SetBaseline(_jobDraft);

            var lResp = await Api.GetAsync<EditLockStatusDto>($"/api/locks/Job/{JobId}");
            if (lResp.IsSuccess) _lockStatus = lResp.Data;

            await RefreshTabDataAsync();
        }
        finally { _loading = false; }
    }

    private async Task SwitchTabAsync(string tab)
    {
        if (_tabLoading || _tab == tab) return;
        _tab = tab;
        _error = null;
        _notice = null;
        _tabLoading = true;
        try { await RefreshTabDataAsync(); }
        finally { _tabLoading = false; }
    }

    private async Task RefreshTabDataAsync()
    {
        if (_tab == "time" && AppState.Can(ModuleKeys.TimeTracking, AccessLevel.Read))
        {
            var response = await Api.GetAsync<List<TimeEntryDto>>($"/api/jobs/{JobId}/time?includeDeleted=false");
            if (response.IsSuccess && response.Data is not null) _timeEntries = response.Data;
            else if (!response.IsSuccess) _error = response.Error;
            var active = await Api.GetAsync<List<TimeEntryDto>>("/api/time/active");
            if (active.IsSuccess && active.Data is not null) AppState.UpdateActiveTimers(active.Data);
            else if (!active.IsSuccess) _error ??= active.Error;
        }
        else if (_tab == "dates" && AppState.Can(ModuleKeys.JobDates, AccessLevel.Read))
        {
            var response = await Api.GetAsync<List<JobDateDto>>($"/api/jobs/{JobId}/dates");
            if (response.IsSuccess && response.Data is not null) _dates = response.Data;
            else if (!response.IsSuccess) _error = response.Error;
        }
        else if (_tab == "items" && AppState.Can(ModuleKeys.JobLineItems, AccessLevel.Read))
        {
            var response = await Api.GetAsync<List<JobLineItemDto>>($"/api/jobs/{JobId}/line-items");
            if (response.IsSuccess && response.Data is not null) _lineItems = response.Data;
            else if (!response.IsSuccess) _error = response.Error;
        }
        else if (_tab == "moodboards" && AppState.Can(ModuleKeys.MoodBoards, AccessLevel.Read))
        {
            var response = await Api.GetAsync<List<MoodBoardDto>>($"/api/jobs/{JobId}/mood-boards");
            if (response.IsSuccess && response.Data is not null)
            {
                _moodBoards = response.Data;
                if (_selectedBoard is null && _moodBoards.Count > 0) SelectBoard(_moodBoards[0]);
                else if (_selectedBoard is not null)
                {
                    var updated = _moodBoards.FirstOrDefault(b => b.Id == _selectedBoard.Id);
                    if (updated is not null) SelectBoard(updated);
                }
            }
            else if (!response.IsSuccess) _error = response.Error;
            if (AppState.Can(ModuleKeys.ImageLibrary, AccessLevel.Read))
            {
                var images = await Api.GetAsync<PagedResult<ImageAssetDto>>("/api/images?page=1&pageSize=30");
                if (images.IsSuccess && images.Data is not null) _availableImages = images.Data.Items.ToList();
                else if (!images.IsSuccess) _error ??= images.Error;
            }
        }
        else if (_tab == "finance" && (AppState.Can(ModuleKeys.Quotes, AccessLevel.Read) || AppState.Can(ModuleKeys.Invoices, AccessLevel.Read)))
        {
            var response = await Api.GetAsync<List<FinancialDocumentDto>>($"/api/jobs/{JobId}/documents");
            if (response.IsSuccess && response.Data is not null) _documents = response.Data;
            else if (!response.IsSuccess) _error = response.Error;
            _lineItemsLoaded = false;
            _newDocIncludeJobItems = false;
            if (AppState.Can(ModuleKeys.JobLineItems, AccessLevel.Read))
            {
                var items = await Api.GetAsync<List<JobLineItemDto>>($"/api/jobs/{JobId}/line-items");
                if (items.IsSuccess && items.Data is not null)
                {
                    _lineItems = items.Data;
                    _lineItemsLoaded = true;
                    _newDocIncludeJobItems = true;
                }
                else if (!items.IsSuccess) _error ??= items.Error;
            }
        }
        else if (_tab == "procurement")
        {
            if (AppState.Can(ModuleKeys.Procurement, AccessLevel.Read))
            {
                var orders = await Api.GetAsync<List<ProcurementItemDto>>($"/api/jobs/{JobId}/procurement");
                if (orders.IsSuccess && orders.Data is not null) _procurement = orders.Data;
                else if (!orders.IsSuccess) _error = orders.Error;
            }
            if (AppState.Can(ModuleKeys.Receipts, AccessLevel.Read))
            {
                var receipts = await Api.GetAsync<List<ReceiptDto>>($"/api/jobs/{JobId}/receipts");
                if (receipts.IsSuccess && receipts.Data is not null) _receipts = receipts.Data;
                else if (!receipts.IsSuccess) _error ??= receipts.Error;
            }
        }
    }

    // --- Exclusive Modify Lock Actions ---
    private async Task RequestModifyAsync()
    {
