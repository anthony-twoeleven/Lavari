    private void OpenNewDocModal(FinancialDocumentType docType)
    {
        _newDocType = docType;
        _newDocMode = "LineCalculated";
        _newDocLineTitle = string.Empty;
        _newDocLinePrice = "0.00";
        _newDocLineQty = "1";
        _newDocDiscount = "0.00";
        _newDocManualTotal = "0.00";
        _showNewDocModal = true;
    }

    private async Task CreateDocumentAsync()
    {
        _saving = true; _error = null;
        try
        {
            var lines = new List<SaveFinancialDocumentLineInput>();
            var adjs = new List<SaveFinancialDocumentAdjustmentInput>();

            if (_newDocMode != "TotalOnly")
            {
                if (_newDocIncludeJobItems)
                {
                    foreach (var li in _lineItems)
                    {
                        lines.Add(new SaveFinancialDocumentLineInput
                        {
                            LineSourceType = FinancialLineSourceType.JobLineItem,
                            SourceEntityId = li.Id,
                            SourceEntityVersion = li.ConcurrencyToken,
                            Title = li.Title,
                            Details = li.RequirementsNote,
                            QuantityMilli = li.QuantityMilli,
                            UnitLabel = li.Unit,
                            UnitPriceCents = li.UnitSellPriceCents,
                            InternalUnitCostCents = li.CostCents
                        });
                    }
                }
                if (!string.IsNullOrWhiteSpace(_newDocLineTitle))
                {
                    var price = Formatting.ParseMoneyInput(_newDocLinePrice, _job!.DefaultCurrency);
                    var qty = decimal.TryParse(_newDocLineQty, out var q) ? (long)(q * 1000m) : 1000L;
                    lines.Add(new SaveFinancialDocumentLineInput { Title = _newDocLineTitle, QuantityMilli = qty, UnitPriceCents = price.Cents });
                }
                var disc = Formatting.ParseMoneyInput(string.IsNullOrWhiteSpace(_newDocDiscount) ? "0" : _newDocDiscount, _job!.DefaultCurrency);
                if (disc.Cents > 0)
                {
                    adjs.Add(new SaveFinancialDocumentAdjustmentInput { AdjustmentType = FinancialAdjustmentType.Discount, Description = "Discount", AmountCents = disc.Cents, IsPreTax = true });
                }
            }

            long? manualCents = _newDocMode == "TotalOnly" ? Formatting.ParseMoneyInput(_newDocManualTotal, _job!.DefaultCurrency).Cents : null;

            var resp = await Api.PostAsync<FinancialDocumentDto>("/api/documents", new CreateFinancialDocumentRequest
            {
                JobId = JobId,
                DocumentType = _newDocType,
                CalculationMode = _newDocMode,
                Currency = _job!.DefaultCurrency,
                ManualTotalCents = manualCents,
                Notes = _newDocNotes,
                Lines = lines,
                Adjustments = adjs
            });
            if (!resp.IsSuccess) { _error = resp.Error; return; }
            _showNewDocModal = false;
            await RefreshTabDataAsync();
        }
        finally { _saving = false; }
    }

