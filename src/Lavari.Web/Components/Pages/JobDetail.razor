    private async Task SaveReceiptAsync()
    {
        if ((_recBytes is null && !_cameraPhoto) || _saving) return;
        _saving = true; _error = null;
        try
        {
            var amt = Formatting.ParseMoneyInput(_recAmount, _job!.DefaultCurrency);
            var fields = new Dictionary<string, string?>
            {
                ["merchantName"] = _recMerchant,
                ["receiptDate"] = _recDate.ToString("yyyy-MM-dd"),
                ["currency"] = _job.DefaultCurrency,
                ["amountCents"] = amt.Cents.ToString()
            };
            var url = $"/api/jobs/{JobId}/receipts";
            var resp = _cameraPhoto
                ? await Api.UploadReceiptPhotoAsync<ReceiptDto>(url, fields)
                : await Api.UploadFileAsync<ReceiptDto>(url, fields, _recFileName, _recContentType, _recBytes!);
            if (!resp.IsSuccess) { _error = resp.Error; return; }
            await ResetReceiptCameraAsync();
            _showReceiptModal = false; _recBytes = null; _recMerchant = string.Empty;
            await RefreshTabDataAsync();
        }
        finally { _saving = false; }
    }

    private async Task StartReceiptCameraAsync()
    {
        var attempt = ++_cameraAttempt;
        _cameraLoading = true;
        _cameraPhoto = false;
        _cameraLive = false;
        _cameraError = null;
        try
        {
            var error = await JS.InvokeAsync<string?>("lavariInterop.startReceiptCamera", _receiptVideo);
            if (attempt != _cameraAttempt) return;
            _cameraError = error;
            _cameraLive = error is null;
        }
        finally
        {
            if (attempt == _cameraAttempt) _cameraLoading = false;
        }
    }

    private async Task TakeReceiptPhotoAsync()
    {
        if (!await JS.InvokeAsync<bool>("lavariInterop.takeReceiptPhoto", _receiptVideo, _receiptCanvas))
        {
            if (_showReceiptModal) _cameraError = "The camera is not ready yet. Try again or choose a photo.";
            return;
        }
        if (!_showReceiptModal) return;
        _cameraPhoto = true;
        _cameraLive = false;
        _cameraError = null;
        _recBytes = null;
    }

    private async Task CloseReceiptAsync()
    {
        if (_saving) return;
        await ResetReceiptCameraAsync();
        _recBytes = null;
        _showReceiptModal = false;
    }

    private async Task ResetReceiptCameraAsync()
    {
        _cameraAttempt++;
        _cameraLive = _cameraPhoto = _cameraLoading = false;
        _cameraError = null;
        await JS.InvokeVoidAsync("lavariInterop.resetReceiptCamera");
    }

    public async ValueTask DisposeAsync()
    {
        if (!_showReceiptModal) return;
        try { await ResetReceiptCameraAsync(); }
        catch (JSDisconnectedException) { }
    }
}
