    private async Task IssueDocumentAsync(FinancialDocumentDto doc)
    {
        _error = null;
        var lockRecType = doc.DocumentType == FinancialDocumentType.Quote ? LockableRecordType.Quote : LockableRecordType.Invoice;
        var lResp = await Api.PostAsync<EditLockStatusDto>("/api/locks/modify", new EditLockActionRequest { RecordType = lockRecType, RecordId = doc.Id });
        if (!lResp.IsSuccess || lResp.Data is null || !lResp.Data.IsHeldByCurrentSession) { _error = lResp.Error; return; }

        var resp = await Api.PostAsync<FinancialDocumentDto>($"/api/documents/{doc.Id}/issue?token={Uri.EscapeDataString(doc.ConcurrencyToken)}&leaseId={lResp.Data.LeaseId}&fencingVersion={lResp.Data.FencingVersion}");
        await Api.PostAsync<EditLockStatusDto>("/api/locks/release", new EditLockActionRequest { RecordType = lockRecType, RecordId = doc.Id, LeaseId = lResp.Data.LeaseId, FencingVersion = lResp.Data.FencingVersion });
        if (!resp.IsSuccess) { _error = resp.Error; return; }
        await RefreshTabDataAsync();
        _notice = $"Issued {doc.DocumentNumber} with immutable Word and PDF snapshots.";
    }

