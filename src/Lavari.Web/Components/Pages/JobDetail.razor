    private async Task SaveLineItemAsync()
    {
        if (_saving || _lockStatus is not { IsHeldByCurrentSession: true, LeaseId: not null, FencingVersion: not null } lease) return;
        _saving = true; _error = null;
        try
        {
            if (!decimal.TryParse(_liQty, out var q) || q <= 0 || q > long.MaxValue / 1000m || decimal.Truncate(q * 1000m) != q * 1000m)
            {
                throw new Lavari.Domain.Errors.ValidationServiceException("Enter a positive quantity with at most three decimal places.");
            }
            var qty = (long)(q * 1000m);
            var cost = Formatting.ParseMoneyInput(_liCost, _job!.DefaultCurrency);
            var sell = Formatting.ParseMoneyInput(_liSell, _job.DefaultCurrency);
            var resp = await Api.PostAsync<JobLineItemDto>($"/api/jobs/{JobId}/line-items", new UpsertJobLineItemRequest
            {
                Title = _liTitle,
                RoomOrArea = _liRoom,
                RequirementsNote = _liReq,
                QuantityMilli = qty,
                Currency = _job.DefaultCurrency,
                CostCents = cost.Cents,
                RrpCents = sell.Cents,
                UnitSellPriceCents = sell.Cents,
                LeaseId = lease.LeaseId,
                FencingVersion = lease.FencingVersion
            });
            if (!resp.IsSuccess)
            {
                _error = resp.Error;
                if (resp.Error?.Code is "LAV-LOCK-001" or "LAV-LOCK-002" or "LAV-LOCK-003")
                {
                    var status = await Api.GetAsync<EditLockStatusDto>($"/api/locks/Job/{JobId}");
                    _lockStatus = status.Data;
                    _showLineItemModal = false;
                }
                return;
            }
            _showLineItemModal = false; _liTitle = string.Empty;
            await RefreshTabDataAsync();
        }
        catch (Lavari.Domain.Errors.ValidationServiceException ex)
        {
            _error = new ApiErrorResponse { Code = ex.ErrorCode, Message = ex.UserMessage, PossibleCause = ex.PossibleCause, CorrelationId = "ui" };
        }
        finally { _saving = false; }
    }

