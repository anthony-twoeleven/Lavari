@page "/"
@inject LavariBrowserApiClient Api
@inject AppSessionState AppState
@inject IFormattingService Formatting

<h1 class="lv-page-title">Dashboard</h1>

<LvErrorBanner Error="_error" />

<div class="lv-grid-4">
    @if (_clientsCount.HasValue) { <LvCard Tonal="true" Title="@_clientsCount.Value.ToString()" Subtitle="Active clients" /> }
    @if (_jobsCount.HasValue) { <LvCard Tonal="true" Title="@_jobsCount.Value.ToString()" Subtitle="Active jobs" /> }
    @if (_productsCount.HasValue) { <LvCard Tonal="true" Title="@_productsCount.Value.ToString()" Subtitle="Catalog products" /> }
    @if (AppState.Can(ModuleKeys.TimeTracking, AccessLevel.Read) && AppState.ActiveTimers.Count > 0)
    { <LvCard Tonal="true" Title="@AppState.ActiveTimers.Count.ToString()" Subtitle="Your active timers" /> }
</div>

@if (AppState.Can(ModuleKeys.Jobs, AccessLevel.Read))
{
    <LvCard Title="Jobs">
        @if (_loading)
        {
            <p><span class="lv-spinner"></span> Loading jobs...</p>
        }
        else if (!_jobsCount.HasValue)
        {
            <p>Jobs could not be loaded.</p>
        }
        else if (_recentJobs.Count == 0)
        {
            <p>No jobs yet.
                @if (AppState.Can(ModuleKeys.Clients, AccessLevel.Read))
                { <a href="/clients">Open clients and jobs</a> }
            </p>
        }
        else
        {
            <div class="lv-table-wrap">
                <table class="lv-table">
                    <thead><tr><th>Job</th><th>Client / Group</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var j in _recentJobs)
                        {
                            <tr>
                                <td><a href="/jobs/@j.Id"><strong>@j.Name</strong></a></td>
                                <td>@j.ClientName / @j.JobGroupName</td>
                                <td><LvBadge Tone="primary">@j.Status</LvBadge></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </LvCard>

}

@code {
    private bool _loading = true;
    private int? _clientsCount;
    private int? _jobsCount;
    private int? _productsCount;
    private List<JobDto> _recentJobs = [];
    private ApiErrorResponse? _error;

    protected override async Task OnInitializedAsync()
    {
        if (!AppState.IsAuthenticated) return;
        _loading = true;
        try
        {
            if (AppState.Can(ModuleKeys.Clients, AccessLevel.Read))
            {
                var c = await Api.GetAsync<PagedResult<ClientDto>>("/api/clients?page=1&pageSize=1");
                if (c.IsSuccess && c.Data is not null) _clientsCount = c.Data.TotalCount;
                else if (!c.IsSuccess) _error = c.Error;
            }
            if (AppState.Can(ModuleKeys.Jobs, AccessLevel.Read))
            {
                var j = await Api.GetAsync<PagedResult<JobDto>>("/api/jobs?page=1&pageSize=8");
                if (j.IsSuccess && j.Data is not null)
                {
                    _jobsCount = j.Data.TotalCount;
                    _recentJobs = j.Data.Items.ToList();
                }
                else if (!j.IsSuccess)
                {
                    _error = j.Error;
                }
            }
            if (AppState.Can(ModuleKeys.ProductCatalog, AccessLevel.Read))
            {
                var p = await Api.GetAsync<PagedResult<ProductDto>>("/api/products?page=1&pageSize=1");
                if (p.IsSuccess && p.Data is not null) _productsCount = p.Data.TotalCount;
                else if (!p.IsSuccess) _error ??= p.Error;
            }
        }
        finally
        {
            _loading = false;
        }
    }
}
