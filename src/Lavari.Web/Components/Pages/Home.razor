@page "/"
@inject LavariBrowserApiClient Api
@inject AppSessionState AppState
@inject IFormattingService Formatting

<h1 style="margin:0;font-size:1.6rem">Studio Dashboard</h1>

<LvErrorBanner Error="_error" />

<div class="lv-grid-4">
    <LvCard Tonal="true" Title="@_clientsCount.ToString()" Subtitle="Active Clients" />
    <LvCard Tonal="true" Title="@_jobsCount.ToString()" Subtitle="Active Jobs" />
    <LvCard Tonal="true" Title="@_productsCount.ToString()" Subtitle="Catalog Products" />
    <LvCard Tonal="true" Title="@AppState.ActiveTimers.Count.ToString()" Subtitle="Your Active Timers" />
</div>

<div class="lv-grid-2">
    <LvCard Title="Recent Jobs" Subtitle="Open a job to manage dates, timers, line items, mood boards, quotes, invoices and procurement">
        @if (_loading)
        {
            <p><span class="lv-spinner"></span> Loading jobs...</p>
        }
        else if (_recentJobs.Count == 0)
        {
            <p>No jobs yet. Create your first client, job group and job in <a href="/clients">Clients &amp; Jobs</a>.</p>
        }
        else
        {
            <div class="lv-table-wrap">
                <table class="lv-table">
                    <thead><tr><th>Job</th><th>Client / Group</th><th>Status</th><th>Zone</th></tr></thead>
                    <tbody>
                        @foreach (var j in _recentJobs)
                        {
                            <tr>
                                <td><a href="/jobs/@j.Id"><strong>@j.Name</strong></a></td>
                                <td>@j.ClientName / @j.JobGroupName</td>
                                <td><LvBadge Tone="primary">@j.Status</LvBadge></td>
                                <td><small>@j.TimeZoneIana</small></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </LvCard>

    <LvCard Title="Quick Actions & Studio Status">
        <div class="lv-row" style="margin-bottom:14px">
            <a class="lv-btn lv-btn-filled" href="/clients">Clients &amp; Jobs</a>
            <a class="lv-btn lv-btn-tonal" href="/products">Product Catalog</a>
            <a class="lv-btn lv-btn-tonal" href="/images">Image Library</a>
            <a class="lv-btn lv-btn-outlined" href="/forecasting">Forecasting</a>
            <a class="lv-btn lv-btn-outlined" href="/admin">Admin</a>
        </div>
        @if (_integrations is not null)
        {
            <div class="lv-banner-warning" style="font-size:0.86rem">
                <strong>Integrations:</strong> @_integrations.StatusSummary
            </div>
        }
    </LvCard>
</div>

@code {
    private bool _loading = true;
    private int _clientsCount;
    private int _jobsCount;
    private int _productsCount;
    private List<JobDto> _recentJobs = [];
    private IntegrationStatusDto? _integrations;
    private ApiErrorResponse? _error;

    protected override async Task OnInitializedAsync()
    {
        if (!AppState.IsAuthenticated) return;
        _loading = true;
        try
        {
            if (AppState.Can(ModuleKeys.Clients, AccessLevel.Read))
            {
                var c = await Api.GetAsync<PagedResult<ClientDto>>("/api/clients?page=1&pageSize=1");
                if (c.IsSuccess && c.Data is not null) _clientsCount = c.Data.TotalCount;
            }
            if (AppState.Can(ModuleKeys.Jobs, AccessLevel.Read))
            {
                var j = await Api.GetAsync<PagedResult<JobDto>>("/api/jobs?page=1&pageSize=8");
                if (j.IsSuccess && j.Data is not null)
                {
                    _jobsCount = j.Data.TotalCount;
                    _recentJobs = j.Data.Items.ToList();
                }
                else if (!j.IsSuccess)
                {
                    _error = j.Error;
                }
            }
            if (AppState.Can(ModuleKeys.ProductCatalog, AccessLevel.Read))
            {
                var p = await Api.GetAsync<PagedResult<ProductDto>>("/api/products?page=1&pageSize=1");
                if (p.IsSuccess && p.Data is not null) _productsCount = p.Data.TotalCount;
            }
            var integ = await Api.GetAsync<IntegrationStatusDto>("/api/integrations/status");
            if (integ.IsSuccess) _integrations = integ.Data;
        }
        finally
        {
            _loading = false;
        }
    }
}
