@page "/account"
@inject LavariBrowserApiClient Api
@inject AppSessionState AppState
@inject Microsoft.JSInterop.IJSRuntime JS
@using Microsoft.JSInterop

<PageTitle>Account settings</PageTitle>
<NavigationLock ConfirmExternalNavigation="@IsDirty" OnBeforeInternalNavigation="BeforeNavigationAsync" />

<h1 class="lv-page-title">Account settings</h1>
<LvErrorBanner Error="_error" />
@if (_previewReverted)
{
    <p role="status">Your saved appearance was restored. Your selections are still available to retry.</p>
}
@if (_loading)
{
    <p role="status">Loading appearance settings...</p>
}
else if (_saved is not null)
{
    <LvCard Title="Appearance" Subtitle="Choose how Lavari looks on your devices.">
        <fieldset class="lv-choice-group" disabled="@(!CanEdit || _saving)">
            <legend>Theme</legend>
            <div class="lv-choice-row">
                @foreach (var option in Modes)
                {
                    <label class="lv-choice">
                        <input type="radio" name="theme-mode" value="@option.Value" checked="@(_mode == option.Value)"
                               @onchange="() => SetModeAsync(option.Value)" />
                        <span>@option.Label</span>
                    </label>
                }
            </div>
        </fieldset>
        <fieldset class="lv-choice-group" disabled="@(!CanEdit || _saving)">
            <legend>Highlight color</legend>
            <div class="lv-choice-row">
                @foreach (var option in Colors)
                {
                    <label class="lv-choice">
                        <input type="radio" name="theme-color" value="@option.Value" checked="@(_color == option.Value)"
                               @onchange="() => SetColorAsync(option.Value)" />
                        <span class="lv-swatch lv-swatch-@option.Value" aria-hidden="true"></span>
                        <span>@option.Label</span>
                    </label>
                }
            </div>
        </fieldset>
        @if (!CanEdit)
        {
            <p>You can view these settings, but you need permission to change them.</p>
        }
        <div class="lv-row">
            <LvButton Loading="_saving" Disabled="@(!CanEdit || !IsDirty)" OnClick="SaveAsync">Save changes</LvButton>
            <LvButton Variant="outlined" Disabled="@(!IsDirty || _saving)" OnClick="CancelAsync">Cancel</LvButton>
            <LvButton Variant="outlined" Disabled="@(!CanEdit || _saving || (_mode == "system" && _color == "lavender"))" OnClick="ResetAsync">Reset to defaults</LvButton>
        </div>
        @if (_savedNotice)
        {
            <p role="status">Appearance saved.</p>
        }
    </LvCard>
}

@code {
    private static readonly (string Value, string Label)[] Modes =
        [("system", "System"), ("light", "Light"), ("dark", "Dark")];
    private static readonly (string Value, string Label)[] Colors =
        [("lavender", "Lavender"), ("blue", "Blue"), ("green", "Green"), ("rose", "Rose")];
    private AppearanceDto? _saved;
    private ApiErrorResponse? _error;
    private string _mode = "system";
    private string _color = "lavender";
    private bool _loading = true;
    private bool _saving;
    private bool _savedNotice;
    private bool _previewReverted;
    private bool CanEdit => AppState.Can(ModuleKeys.AccountAppearance, AccessLevel.Alter);
    private bool IsDirty => _saved is not null && (_mode != _saved.Mode || _color != _saved.Color);

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.GetAsync<AppearanceDto>("/api/account/appearance");
        if (result.IsSuccess && result.Data is not null)
        {
            _saved = result.Data;
            _mode = _saved.Mode;
            _color = _saved.Color;
        }
        else _error = result.Error;
        _loading = false;
    }

    private async Task SetModeAsync(string mode) { _mode = mode; _savedNotice = false; _previewReverted = false; await PreviewAsync(); }
    private async Task SetColorAsync(string color) { _color = color; _savedNotice = false; _previewReverted = false; await PreviewAsync(); }
    private Task PreviewAsync() => Api.SetAppearanceAsync(_mode, _color).AsTask();

    private async Task ResetAsync()
    {
        _mode = "system";
        _color = "lavender";
        _savedNotice = false;
        _previewReverted = false;
        await PreviewAsync();
    }

    private async Task CancelAsync()
    {
        if (_saved is null) return;
        _mode = _saved.Mode;
        _color = _saved.Color;
        _error = null;
        _savedNotice = false;
        _previewReverted = false;
        await PreviewAsync();
    }

    private async Task SaveAsync()
    {
        if (_saved is null || !CanEdit || !IsDirty || _saving) return;
        _saving = true;
        _error = null;
        try
        {
            var result = await Api.PutAsync<AppearanceDto>("/api/account/appearance", new UpdateAppearanceRequest
            {
                Mode = _mode, Color = _color, ConcurrencyToken = _saved.ConcurrencyToken
            });
            if (result.IsSuccess && result.Data is not null)
            {
                _saved = result.Data;
                _savedNotice = true;
                _previewReverted = false;
                await Api.SetAppearanceAsync(_saved.Mode, _saved.Color);
            }
            else
            {
                _error = result.Error;
                _previewReverted = true;
                await Api.SetAppearanceAsync(_saved.Mode, _saved.Color);
            }
        }
        finally { _saving = false; }
    }

    private async Task BeforeNavigationAsync(LocationChangingContext context)
    {
        if (!IsDirty) return;
        if (!await JS.InvokeAsync<bool>("confirm", "Discard your appearance changes?"))
        {
            context.PreventNavigation();
            return;
        }
        await CancelAsync();
    }
}
