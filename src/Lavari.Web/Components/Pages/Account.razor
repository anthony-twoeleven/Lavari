@page "/account"
@inject LavariBrowserApiClient Api
@inject AppSessionState AppState
@inject Microsoft.JSInterop.IJSRuntime JS
@using Microsoft.JSInterop

<PageTitle>Account settings</PageTitle>
<NavigationLock ConfirmExternalNavigation="@IsDirty" OnBeforeInternalNavigation="BeforeNavigationAsync" />

<h1 class="lv-page-title">Account settings</h1>
<LvErrorBanner Error="_error" />
@if (_previewReverted)
{
    <p class="lv-appearance-status" role="status">Your saved appearance was restored. Your selections are still available to retry.</p>
}
@if (_loading)
{
    <p role="status">Loading appearance settings...</p>
}
else if (_saved is not null)
{
    <section class="lv-appearance" aria-labelledby="appearance-heading">
        <div class="lv-appearance-heading">
            <div>
                <p class="lv-eyebrow">PERSONALIZE YOUR WORKSPACE</p>
                <h2 id="appearance-heading">Appearance</h2>
                <p>Choose a light or dark canvas, then give your studio a considered color story.</p>
            </div>
            <span class="lv-appearance-badge"><span aria-hidden="true">✦</span> Material color roles</span>
        </div>

        <fieldset class="lv-appearance-group lv-theme-options" disabled="@(!CanEdit || _saving)">
            <legend><span>01</span> Theme <small>Choose the surface that feels right</small></legend>
            <div class="lv-appearance-grid lv-theme-grid">
                @foreach (var option in Modes)
                {
                    <label class="lv-appearance-option lv-theme-option">
                        <input type="radio" name="theme-mode" value="@option.Value" checked="@(_mode == option.Value)"
                               @onchange="() => SetModeAsync(option.Value)" />
                        <span class="lv-option-check" aria-hidden="true">✓</span>
                        <span class="lv-theme-preview lv-theme-preview-@option.Value" aria-hidden="true">
                            <span class="lv-theme-preview-bar"></span>
                            <span class="lv-theme-preview-body">
                                <span class="lv-theme-preview-rail"></span>
                                <span class="lv-theme-preview-card">
                                    <span></span><span></span><span></span>
                                </span>
                            </span>
                            @if (option.Value == "system")
                            {
                                <span class="lv-theme-preview-system-icon">◐</span>
                            }
                        </span>
                        <span class="lv-option-copy">
                            <strong>@option.Label</strong>
                            <small>@option.Description</small>
                        </span>
                    </label>
                }
            </div>
        </fieldset>

        <fieldset class="lv-appearance-group lv-palette-options" disabled="@(!CanEdit || _saving)">
            <legend><span>02</span> Color palette <small>Five coordinated, static schemes for light and dark</small></legend>
            <div class="lv-appearance-grid lv-palette-grid">
                @foreach (var option in Colors)
                {
                    <label class="lv-appearance-option lv-palette-option">
                        <input type="radio" name="theme-color" value="@option.Value" checked="@(_color == option.Value)"
                               @onchange="() => SetColorAsync(option.Value)" />
                        <span class="lv-option-check" aria-hidden="true">✓</span>
                        <span class="lv-palette-card-heading">
                            <span class="lv-palette-swatch lv-palette-swatch-@option.Value" aria-hidden="true"></span>
                            <span class="lv-option-copy">
                                <strong>@option.Label</strong>
                                <small>@option.Description</small>
                            </span>
                        </span>
                        <span class="lv-palette-preview" data-palette="@option.Value" aria-hidden="true">
                            <span class="lv-palette-demo-toolbar"><span></span><span></span><span></span></span>
                            <span class="lv-palette-demo-content">
                                <span class="lv-palette-demo-title"><span></span><span></span></span>
                                <span class="lv-palette-demo-button">New project</span>
                                <span class="lv-palette-demo-chip">In progress</span>
                            </span>
                            <span class="lv-palette-role-swatches">
                                <span><i></i><small>Primary</small></span>
                                <span><i></i><small>Secondary</small></span>
                                <span><i></i><small>Tertiary</small></span>
                                <span><i></i><small>Neutral</small></span>
                            </span>
                        </span>
                    </label>
                }
            </div>
        </fieldset>
        @if (!CanEdit)
        {
            <p class="lv-appearance-permission">You can view these settings, but you need permission to change them.</p>
        }
        <div class="lv-appearance-actions">
            <span class="lv-appearance-hint">Your changes preview here and are only saved when you apply them.</span>
            <div class="lv-row">
                <LvButton Loading="_saving" Disabled="@(!CanEdit || !IsDirty)" OnClick="SaveAsync">Apply appearance</LvButton>
                <LvButton Variant="outlined" Disabled="@(!IsDirty || _saving)" OnClick="CancelAsync">Cancel</LvButton>
                <LvButton Variant="outlined" Disabled="@(!CanEdit || _saving || (_mode == "system" && _color == "purple"))" OnClick="ResetAsync">Reset</LvButton>
            </div>
        </div>
        @if (_savedNotice)
        {
            <p class="lv-appearance-status" role="status">Appearance saved across your devices.</p>
        }
    </section>
}

@code {
    private static readonly (string Value, string Label, string Description)[] Modes =
        [("system", "System", "Follow your device"),
         ("light", "Light", "Bright and airy"),
         ("dark", "Dark", "Soft on the eyes")];
    private static readonly (string Value, string Label, string Description)[] Colors =
        [("purple", "Muted Plum", "Dusty lavender and deep aubergine"),
         ("green", "Sage & Eucalyptus", "Soft moss and eucalyptus teal"),
         ("coral", "Terracotta & Blush", "Refined clay, blush and warm ochre"),
         ("blue", "Slate & Nordic Dusk", "Architectural blue-grey and periwinkle"),
         ("neutral", "Warm Stone & Charcoal", "Warm taupe and quiet sage-grey")];
    private AppearanceDto? _saved;
    private ApiErrorResponse? _error;
    private string _mode = "system";
    private string _color = "purple";
    private bool _loading = true;
    private bool _saving;
    private bool _savedNotice;
    private bool _previewReverted;
    private bool CanEdit => AppState.Can(ModuleKeys.AccountAppearance, AccessLevel.Alter);
    private bool IsDirty => _saved is not null && (_mode != _saved.Mode || _color != _saved.Color);

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.GetAsync<AppearanceDto>("/api/account/appearance");
        if (result.IsSuccess && result.Data is not null)
        {
            _saved = result.Data;
            _mode = _saved.Mode;
            _color = _saved.Color;
        }
        else _error = result.Error;
        _loading = false;
    }

    private async Task SetModeAsync(string mode) { _mode = mode; _savedNotice = false; _previewReverted = false; await PreviewAsync(); }
    private async Task SetColorAsync(string color) { _color = color; _savedNotice = false; _previewReverted = false; await PreviewAsync(); }
    private Task PreviewAsync() => Api.SetAppearanceAsync(_mode, _color).AsTask();

    private async Task ResetAsync()
    {
        _mode = "system";
        _color = "purple";
        _savedNotice = false;
        _previewReverted = false;
        await PreviewAsync();
    }

    private async Task CancelAsync()
    {
        if (_saved is null) return;
        _mode = _saved.Mode;
        _color = _saved.Color;
        _error = null;
        _savedNotice = false;
        _previewReverted = false;
        await PreviewAsync();
    }

    private async Task SaveAsync()
    {
        if (_saved is null || !CanEdit || !IsDirty || _saving) return;
        _saving = true;
        _error = null;
        try
        {
            var result = await Api.PutAsync<AppearanceDto>("/api/account/appearance", new UpdateAppearanceRequest
            {
                Mode = _mode, Color = _color, ConcurrencyToken = _saved.ConcurrencyToken
            });
            if (result.IsSuccess && result.Data is not null)
            {
                _saved = result.Data;
                _savedNotice = true;
                _previewReverted = false;
                await Api.SetAppearanceAsync(_saved.Mode, _saved.Color);
            }
            else
            {
                _error = result.Error;
                _previewReverted = true;
                await Api.SetAppearanceAsync(_saved.Mode, _saved.Color);
            }
        }
        finally { _saving = false; }
    }

    private async Task BeforeNavigationAsync(LocationChangingContext context)
    {
        if (!IsDirty) return;
        bool confirmed;
        try { confirmed = await JS.InvokeAsync<bool>("confirm", "Discard your appearance changes?"); }
        catch (JSDisconnectedException)
        {
            context.PreventNavigation();
            return;
        }
        if (!confirmed)
        {
            context.PreventNavigation();
            return;
        }
        await CancelAsync();
    }
}
