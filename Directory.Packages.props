<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Aspire & ServiceDefaults (MIT) -->
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.6.5" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.1" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />

    <!-- EF Core & SQLite (MIT) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />

    <!-- Caching & Core Extensions (MIT) -->
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.15" />

    <!-- Components & SignalR (MIT) -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.15" />

    <!-- Open-source Scheduler: TickerQ 10.4.0 (MIT OR Apache-2.0) -->
    <PackageVersion Include="TickerQ" Version="10.4.0" />
    <PackageVersion Include="TickerQ.EntityFrameworkCore" Version="10.4.0" />

    <!-- Open-source Word & Image/PDF Processing (MIT) -->
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageVersion Include="SkiaSharp" Version="4.157.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.157.0" />

    <!-- Testing & Benchmarking (MIT / Apache-2.0) -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
</Project>
